{
  "name": "televecha",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "dev": "vp dev",
    "dev:e2e": "VITE_TELEVECHA_E2E=1 node scripts/playwright-server.mjs",
    "build": "vp build",
    "check": "tsc --noEmit && vp check",
    "fmt": "vp fmt",
    "check:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "fetch:telegram-tl": "node scripts/fetch-telegram-tl.mjs",
    "check:telegram-tl-sources": "node scripts/fetch-telegram-tl.mjs --check",
    "generate:telegram-tl": "node scripts/generate-telegram-tl.mjs",
    "tvbug": "node scripts/inspect-tvbug.mjs",
    "check:telegram-tl": "node scripts/generate-telegram-tl.mjs --check",
    "test": "vp test --run",
    "test:coverage": "vp test --run --coverage",
    "test:watch": "vp test",
    "test:e2e": "playwright test",
    "test:all": "npm run check:telegram-tl && npm run check && npm run check:e2e && npm test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-rc.112",
    "@effectweb/lucide": "0.5.0",
    "@noble/ciphers": "^2.4.0",
    "effect": "4.0.0-rc.112",
    "effectweb": "0.5.0",
    "fflate": "^0.8.3",
    "idb": "8.0.3",
    "lottie-web": "^5.13.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.32.1",
    "@effectweb/compiler": "0.5.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@voidzero-dev/vite-plus-core": "0.2.9",
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite-plus": "0.2.9"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "engines": {
    "node": ">=22.14"
  }
}
