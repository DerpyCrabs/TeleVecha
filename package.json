{
  "name": "televecha",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "dev": "vp dev",
    "dev:e2e": "VITE_TELEVECHA_E2E=1 node scripts/playwright-server.mjs",
    "build": "vp build",
    "check": "tsc --noEmit && vp check",
    "fmt": "vp fmt",
    "check:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "fetch:telegram-tl": "node scripts/fetch-telegram-tl.mjs",
    "check:telegram-tl-sources": "node scripts/fetch-telegram-tl.mjs --check",
    "generate:telegram-tl": "node scripts/generate-telegram-tl.mjs",
    "tvbug": "node scripts/inspect-tvbug.mjs",
    "check:telegram-tl": "node scripts/generate-telegram-tl.mjs --check",
    "test": "vp test --run",
    "test:coverage": "vp test --run --coverage",
    "test:watch": "vp test",
    "test:e2e": "playwright test",
    "test:all": "npm run check:telegram-tl && npm run check && npm run check:e2e && npm test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.0",
    "@effectweb/lucide": "0.15.0",
    "@effectweb/query": "0.15.0",
    "@noble/ciphers": "^2.4.0",
    "@telegram/widget-sandbox": "file:vendor/telegram-widget-sandbox-0.6.0.tgz",
    "@telegram/widget-sandbox-quickjs": "file:vendor/telegram-widget-sandbox-quickjs-0.32.0-fork.tgz",
    "effect": "4.1.0",
    "effectweb": "0.15.0",
    "fflate": "^0.8.3",
    "idb": "8.0.4",
    "katex": "^0.19.1",
    "lottie-web": "^5.13.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@effectweb/compiler": "0.15.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@voidzero-dev/vite-plus-core": "1.4.0",
    "fake-indexeddb": "^6.2.7",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "htmlparser2": "10.1.0",
    "linkedom": "0.18.13",
    "parse5": "8.0.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": ">=22.14"
  }
}
